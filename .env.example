# Copy to .env in the project root and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# MySQL / MariaDB (on cPanel: create the database + user in "MySQL Databases"; names get a cPanel prefix)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=svesconnect

# Long random string used to sign login tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# First administrator, created by `npm run migrate`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI assistant (Groq key from https://console.groq.com)
GROK_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Where uploaded equipment documents are stored (outside the web root). Default: <app>/storage
# STORAGE_DIR=/home/CPANELUSER/svesconnect/storage
