{
  "name": "svesconnect",
  "version": "1.0.0",
  "private": true,
  "description": "SVES Connect: document portal + AI infrastructure chatbot in one app",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.js",
    "lint": "eslint .",
    "migrate": "node server/db/migrate.js",
    "import:baja": "node server/db/importBaja.js",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
